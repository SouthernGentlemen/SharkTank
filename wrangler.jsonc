{
  // Local host worker. `wrangler dev` runs this on workerd/Miniflare — the same
  // runtime we'll deploy to on Cloudflare. Keep this config Workers-deployable.
  "name": "sharktank-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ENVIRONMENT": "development", "SHARKTANK_RELEASE": "development", "SHARKTANK_RELEASE_REVISION": "development", "AUDIT_GENERATION": "2026-08-18-wizardgang-ai-shark-reset-3", "GAME_LOG_GENERATION": "2026-08-18-shark-capture-reset-2", "BILLING_HARD_LIMIT_USD": "5", "R2_BUCKET_NAME": "wizardgang-demo-assets", "R2_PREFIX": "sharktank/development/" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker owns application routing. /play/ explicitly fetches the built index.html;
    // missing application paths and missing assets must never fall back to that document.
    "html_handling": "none",
    "not_found_handling": "none",
    // Every request still passes through the Worker so maintenance/security policy can
    // replace the game document and immutable asset requests when required.
    "run_worker_first": true
  },
  // Authoritative realtime: Room hosts one arena's sim over a WebSocket; Lobby is a
  // single presence/leaderboard aggregator (addressed by idFromName("global")).
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "r2_buckets": [{ "binding": "R2_ASSETS", "bucket_name": "wizardgang-demo-assets" }],
  // Daily copy of tank state to object storage (A.8.13). The handler is scheduled() in
  // src/worker/index.ts; it receipts its own outcome, success or failure.
  "triggers": { "crons": ["17 3 * * *"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] }],
  "env": {
    "wizardgangprod": {
      "name": "wizardgangprod",
      // account_id is deliberately absent: it is an account identifier and this file is
      // tracked. It comes from CLOUDFLARE_ACCOUNT_ID in .env (gitignored), which
      // scripts/deploy-prod.mjs loads before invoking wrangler.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "sharktank.wizardgang.ai", "custom_domain": true }],
      "vars": { "ENVIRONMENT": "production", "SHARKTANK_RELEASE": "unreleased", "SHARKTANK_RELEASE_REVISION": "unreleased", "AUDIT_GENERATION": "2026-08-18-wizardgang-ai-shark-reset-3", "GAME_LOG_GENERATION": "2026-08-18-shark-capture-reset-2", "BILLING_HARD_LIMIT_USD": "5", "R2_BUCKET_NAME": "wizardgang-demo-assets", "R2_PREFIX": "sharktank/production/" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "r2_buckets": [{ "binding": "R2_ASSETS", "bucket_name": "wizardgang-demo-assets" }],
      // Cron triggers are non-inheritable and must be repeated per env.
      "triggers": { "crons": ["17 3 * * *"] },
      // Durable Object bindings are non-inheritable and must be repeated per env.
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" },
          { "name": "LOBBY", "class_name": "Lobby" }
        ]
      }
    }
  }
}
