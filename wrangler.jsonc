{
  // Local host worker. `wrangler dev` runs this on workerd/Miniflare — the same
  // runtime we'll deploy to on Cloudflare. Keep this config Workers-deployable.
  "name": "sharktank-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ENVIRONMENT": "development", "SHARKTANK_RELEASE": "development", "SHARKTANK_RELEASE_REVISION": "development" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker owns application routing. /play/ explicitly fetches the built index.html;
    // missing application paths and missing assets must never fall back to that document.
    "html_handling": "none",
    "not_found_handling": "none",
    // Every request still passes through the Worker so maintenance/security policy can
    // replace the game document and immutable asset requests when required.
    "run_worker_first": true
  },
  // Authoritative realtime: Room hosts the tank simulation over a WebSocket.
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "env": {
    "wizardgangprod": {
      "name": "wizardgangprod",
      // account_id is deliberately absent: it is an account identifier and this file is
      // tracked. It comes from CLOUDFLARE_ACCOUNT_ID in .env (gitignored), which
      // scripts/deploy-prod.mjs loads before invoking wrangler.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "sharktank.wizardgang.ai", "custom_domain": true }],
      "vars": { "ENVIRONMENT": "production", "SHARKTANK_RELEASE": "unreleased", "SHARKTANK_RELEASE_REVISION": "unreleased" },
      // Durable Object bindings are non-inheritable and must be repeated per env.
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" }
        ]
      }
    }
  }
}
