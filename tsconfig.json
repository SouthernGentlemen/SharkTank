{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "@cloudflare/workers-types",
      "vite/client"
    ],
    "paths": {
      "module-react3fiber/app": [
        "./vendor/ModuleReact3Fiber/src/client/App.tsx"
      ],
      "module-react3fiber/*": [
        "./vendor/ModuleReact3Fiber/src/*/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "vite.config.ts"
  ]
}
