{
  "name": "sharktank",
  "version": "2.4.0",
  "releaseRevision": 0,
  "private": true,
  "license": "MIT",
  "description": "Realtime multiplayer SharkTank with protected release and production controls.",
  "type": "module",
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "packageManager": "npm@12.1.0",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": false,
    "workerd@1.20261001.1": true
  },
  "scripts": {
    "local": "node scripts/local.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "check:history": "node scripts/check-history.mjs",
    "check": "npm run test:plan-queue && npm run check:implementation-plan && npm run test:release-tagging && npm run test:release-publication && npm run check:release-workflow && npm run test:release-identity && npm run check:platform && npm run typecheck && npm test && npm run build && npm run check:repository-baseline && npm run check:change-contract && npm run test:github-settings && npm run check:history && npm run test:public-secrets && npm run check:public-secrets && npm run check:local-processes && npm run check:local-reset && npm run check:local-readiness && npm run check:dev-command && npm run check:local-http && npm run test:dependency-advisories && npm run check:whitespace",
    "test:public-secrets": "node --test scripts/public-secret-cases.mjs",
    "check:public-secrets": "node scripts/check-public-secrets.mjs",
    "test:dependency-advisories": "node --test scripts/dependency-advisory-cases.mjs",
    "audit:dependencies": "node scripts/dependency-advisories.mjs",
    "check:game-surface": "node scripts/check-game-surface.mjs",
    "dev": "node scripts/local.mjs",
    "start": "npm run dev:worker",
    "check:change-contract": "node --test scripts/change-contract-cases.mjs && node scripts/check-change-contract.mjs",
    "check:local-http": "node --test scripts/local-worker-acceptance-cases.mjs && node scripts/check-local-http.mjs --cleanup-proof && node scripts/check-local-http.mjs",
    "check:whitespace": "git diff --check HEAD^",
    "test:github-settings": "node --test scripts/github-settings-cases.mjs",
    "verify:github-settings": "node scripts/verify-github-settings.mjs",
    "apply:github-settings": "node scripts/apply-github-settings.mjs",
    "check:repository-baseline": "node scripts/check-repository-baseline.mjs",
    "check:implementation-plan": "node --test scripts/implementation-plan-cases.mjs && node scripts/check-implementation-plan.mjs",
    "test:plan-queue": "node scripts/check-portfolio-contract.mjs",
    "tag:release": "node scripts/release-tag.mjs",
    "test:release-tagging": "node --test scripts/release-tag-cases.mjs",
    "test:release-publication": "node --test scripts/release-publication-cases.mjs",
    "check:release-workflow": "node --test scripts/release-workflow-cases.mjs",
    "test:release-identity": "node --test scripts/release-identity-cases.mjs",
    "check:release-identity": "node scripts/release-identity.mjs",
    "check:local-processes": "node --test scripts/local-process-ownership-cases.mjs",
    "check:local-reset": "node --test scripts/local-reset-cases.mjs",
    "check:local-readiness": "node --test scripts/local-readiness-cases.mjs",
    "dev:worker": "wrangler dev --port 8787",
    "check:dev-command": "node --test scripts/dev-command-cases.mjs",
    "pretypecheck": "node scripts/generate-worker-release.mjs",
    "prebuild": "node scripts/generate-worker-release.mjs",
    "check:platform": "node platform/conformance/cli.mjs pin && node platform/conformance/cli.mjs wrangler --worker sharktank"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261005.1",
    "@types/node": "26.6.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "undici": "7.29.1",
    "sharp": "0.35.5"
  }
}
